# --- Обязательные ---

# Настройка места хранения docker-compose
COMPOSE_FILE=infra/docker-compose.yml
COMPOSE_PROJECT_NAME=lyria-bot

# Режим разработки. False - меняет хост Redi/Postgres на localhost для доступа к ним снаружи
# После включения необходимо в docker-compose.yaml раскомментировать секции с портами
DEV_MODE=True

# Токен бота от @BotFather
BOT_TOKEN=

# Ключ API OpenRouter
OPENROUTER_API_KEY=

# Ключ доступа: его пользователь присылает боту после /start, чтобы войти
BOT_ACCESS_KEY=

# Стоимость одной генерации в долларах (например, 0.05) —
# из неё считается остаток песен в разделе "Кредиты"
SONG_PRICE=

# --- Опциональные ---

# Модель OpenRouter для генерации
MODEL_ID=google/lyria-3-pro-preview

# Telegram ID владельца: ему уходят отчёты об ошибках.
# Не оставляйте пустым — укажите 0, чтобы отключить отчёты
BOT_OWNER_ID=0

# 1 — демо-режим: без обращения к OpenRouter, аудио берётся из MOCK_FILE
MOCK_MODE=1
# JSON-файл с аудио в base64 для демо-режима
MOCK_FILE=
# Ожидаемое время генерации файла в секундах для прогресс-бара
TYPICAL_GENERATION_SECONDS=30.0

# Обогащение промпта через Open WebUI (OpenAI-совместимый API):
# URL чат-комплишн эндпоинта обогатителя. Пустые значения отключают
# обогащение — бот предложит продолжить с исходным описанием песни
ENRICH_URL=
# Токен доступа к обогатителю
ENRICH_TOKEN=
# Модель обогатителя в терминах Open WebUI
ENRICH_MODEL=

# --- Инфраструктура ---

# Параметры PostgreSQL (используются docker-compose при создании контейнера БД)
POSTGRES_USER=lyria
POSTGRES_PASSWORD=lyria
POSTGRES_DB=lyria
# Хост и порт для подключения бота и alembic:
# внутри docker-сети — postgres:5432, при локальном запуске — localhost:5432
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Параметры Redis для FSM-хранилища:
# внутри docker-сети — redis:6379, при локальном запуске — localhost:6379
# Адрес Redis для FSM-хранилища (в docker-compose переопределяется)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_VAULT=0