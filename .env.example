# --- Обязательные ---

# Настройка места хранения docker-compose
COMPOSE_FILE=infra/docker-compose.yml
COMPOSE_PROJECT_NAME=lyria-bot

# Токен бота от @BotFather
BOT_TOKEN=

# Ключ API OpenRouter
OPENROUTER_API_KEY=

# Ключ доступа: его пользователь присылает боту после /start, чтобы войти
BOT_ACCESS_KEY=

# Стоимость одной генерации в долларах (например, 0.05) —
# из неё считается остаток песен в разделе "Кредиты"
SONG_PRICE=

# --- Опциональные ---

# Модель OpenRouter для генерации
MODEL_ID=google/lyria-3-pro-preview

# Telegram ID владельца: ему уходят отчёты об ошибках.
# Не оставляйте пустым — укажите 0, чтобы отключить отчёты
BOT_OWNER_ID=0

# 1 — демо-режим: без обращения к OpenRouter, аудио берётся из MOCK_FILE
MOCK_MODE=1
# JSON-файл с аудио в base64 для демо-режима
MOCK_FILE=
